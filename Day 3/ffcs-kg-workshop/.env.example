# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# Only the two notebooks' LIVE answer cells need this. The graph, the vector
# store, the coverage test and the ablation all run offline, and both notebooks
# open with answers recorded from earlier runs.
#
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# The free tier is 5 requests/minute plus a small daily cap. If the daily cap is
# exhausted, switching model id here is faster than waiting for a reset.
GEMINI_MODEL=gemini-3-flash-preview

# Host ports, in case these are already in use on your machine.
# JUPYTER_PORT=8888
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# Linux only: run the container as you, so files it writes are not owned by root.
# Set with:  DOCKER_UID=$(id -u) DOCKER_GID=$(id -g)
# The 1000/1000 defaults are right on most single-user machines.
# DOCKER_UID=1000
# DOCKER_GID=1000
