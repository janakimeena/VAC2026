# Copy to .streamlit/secrets.toml for local runs; paste the same keys into
# "Advanced settings -> Secrets" when deploying on Streamlit Community Cloud.
#
# secrets.toml is gitignored. Never commit a real key: a Community Cloud repo is
# usually public, and a key in git history stays there after you delete the line.

# --- Neo4j -----------------------------------------------------------------
# Aura gives you these when you create an instance. Download the credentials file it
# offers at creation time - the password is shown exactly once.
#
# Copy all four verbatim. USERNAME and DATABASE are usually "neo4j", but some
# instances use the instance id (the subdomain of the URI) for both. Guessing gives
# an AuthError or a DatabaseNotFound rather than a message naming the wrong field.
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = ""
NEO4J_PASSWORD = ""
NEO4J_DATABASE = ""

# --- Gemini ----------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Every visitor's questions spend THIS key's quota. See the README on limiting
# exposure before sharing the URL widely.
GOOGLE_API_KEY = ""
GEMINI_MODEL = "gemini-3-flash-preview"
